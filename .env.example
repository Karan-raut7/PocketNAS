# Security (Replace with a strong, random string in your real .env file)
SECRET_KEY=your_super_secret_jwt_key_here

# Storage Settings
STORAGE_DIR=./storage
MAX_FILE_SIZE=52428800  # 50 MB in bytes
CHUNK_SIZE=1048576      # 1 MB in bytes

# Database Configuration (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/pocket_server_db